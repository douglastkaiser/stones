rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is a player in the game
    function isPlayer(gameData) {
      return isAuthenticated() && (
        (gameData.white != null && gameData.white.id == request.auth.uid) ||
        (gameData.black != null && gameData.black.id == request.auth.uid)
      );
    }

    // Helper function to validate player object structure
    function isValidPlayer(player) {
      return player.keys().hasAll(['id', 'displayName']) &&
             player.id is string &&
             player.displayName is string &&
             player.displayName.size() > 0 &&
             player.displayName.size() <= 30 &&
             validPieceStyle(player.get('pieceStyle', 'standard'));
    }

    function validPieceStyle(style) {
      return style in ['standard', 'stone', 'polishedMarble', 'morocco', 'kyoto'];
    }

    function validBoardTheme(theme) {
      return theme in ['classicWood', 'darkStone', 'marble', 'morocco', 'kyoto'];
    }

    // Helper function to validate move object structure
    function isValidMove(move) {
      return move.keys().hasAll(['notation', 'player']) &&
             move.notation is string &&
             move.notation.size() > 0 &&
             move.notation.size() <= 20 && // Reasonable max for move notation
             move.player is string &&
             move.player in ['white', 'black'];
    }

    // Helper function to validate board size
    function isValidBoardSize(size) {
      return size is int && size >= 3 && size <= 8;
    }

    // Helper function to validate game status
    function isValidStatus(status) {
      return status in ['waiting', 'playing', 'finished'];
    }

    // Helper function to validate winner
    function isValidWinner(winner) {
      return winner == null || winner in ['white', 'black', 'draw'];
    }

    // Games collection rules
    match /games/{roomCode} {
      function squareJoin(color, other) {
        return resource.data.status == 'waiting' &&
          resource.data[color] == null &&
          request.resource.data[color].id == request.auth.uid &&
          isValidPlayer(request.resource.data[color]) &&
          request.resource.data[other] == resource.data[other] &&
          request.resource.data.status == 'playing' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([color, 'status', 'lastMoveAt']);
      }


      // Allow authenticated users to read games they are part of
      allow read: if isAuthenticated() && (
        // Can read if you're a player in the game
        isPlayer(resource.data) ||
        // Or if the game is still waiting (to allow joining)
        resource.data.status == 'waiting'
      );

      // Allow authenticated users to create new games
      allow create: if isAuthenticated() &&
        // Validate required fields exist
        request.resource.data.keys().hasAll([
          'roomCode', 'white', 'boardSize', 'moves', 'status', 'currentTurn'
        ]) &&
        // Room code must be 6 uppercase letters
        request.resource.data.roomCode is string &&
        request.resource.data.roomCode.matches('^[A-Z]{6}$') &&
        request.resource.data.get('creatorColor', 'white') in ['white', 'black'] &&
        request.resource.data[request.resource.data.get('creatorColor', 'white')].id == request.auth.uid &&
        isValidPlayer(request.resource.data[request.resource.data.get('creatorColor', 'white')]) &&
        ((request.resource.data.get('creatorColor', 'white') == 'white' && request.resource.data.black == null) ||
         (request.resource.data.get('creatorColor', 'white') == 'black' && request.resource.data.white == null)) &&
        validBoardTheme(request.resource.data.get('boardTheme', 'classicWood')) &&
        // Validate board size
        isValidBoardSize(request.resource.data.boardSize) &&
        // Moves must be empty array initially
        request.resource.data.moves is list &&
        request.resource.data.moves.size() == 0 &&
        // Status must be 'waiting'
        request.resource.data.status == 'waiting' &&
        // Current turn must be white
        request.resource.data.currentTurn == 'white' &&
        // Winner must be null
        (!request.resource.data.keys().hasAll(['winner']) || request.resource.data.winner == null);

      // Allow updates under specific conditions
      allow update: if isAuthenticated() &&
        request.resource.data.get('boardTheme', 'classicWood') == resource.data.get('boardTheme', 'classicWood') &&
        request.resource.data.get('creatorColor', 'white') == resource.data.get('creatorColor', 'white') && (
        // A joining player fills the vacant color; host metadata is immutable.
        (squareJoin('black', 'white') || squareJoin('white', 'black')) ||

        // Scenario 2: Player making a move
        (isPlayer(resource.data) &&
         resource.data.status == 'playing' &&
         // Only allow adding one move at a time
         request.resource.data.moves.size() == resource.data.moves.size() + 1 &&
         // Validate the new move
         isValidMove(request.resource.data.moves[request.resource.data.moves.size() - 1]) &&
         // Ensure it's the player's turn
         ((resource.data.currentTurn == 'white' && resource.data.white.id == request.auth.uid) ||
          (resource.data.currentTurn == 'black' && resource.data.black.id == request.auth.uid)) &&
         // Validate status transition
         isValidStatus(request.resource.data.status) &&
         // Validate winner if set
         isValidWinner(request.resource.data.winner) &&
         // Ensure players aren't modified
         request.resource.data.white == resource.data.white &&
         request.resource.data.black == resource.data.black &&
         request.resource.data.boardSize == resource.data.boardSize
        ) ||

        // Scenario 3: Player resigning
        (isPlayer(resource.data) &&
         resource.data.status == 'playing' &&
         request.resource.data.status == 'finished' &&
         isValidWinner(request.resource.data.winner) &&
         request.resource.data.winner != null &&
         // Ensure players and other data aren't modified
         request.resource.data.white == resource.data.white &&
         request.resource.data.black == resource.data.black &&
         request.resource.data.boardSize == resource.data.boardSize &&
         request.resource.data.moves == resource.data.moves &&
         request.resource.data.currentTurn == resource.data.currentTurn
        ) ||

        // Scenario 4: Rematch request (reset game state)
        (isPlayer(resource.data) &&
         resource.data.status == 'finished' &&
         request.resource.data.status == 'waiting' &&
         request.resource.data.moves is list &&
         request.resource.data.moves.size() == 0 &&
         request.resource.data.winner == null &&
         request.resource.data.currentTurn == 'white' &&
         // Ensure players aren't modified
         request.resource.data.white == resource.data.white &&
         request.resource.data.black == resource.data.black &&
         request.resource.data.boardSize == resource.data.boardSize
        )
      );

      // Prevent deletion of games (archive instead if needed)
      allow delete: if false;
    }

    // Separate, versioned three-player variant. Cosmetic metadata is independent
    // of the rules log; its already-applied prefix remains immutable.
    match /hexGames/{code} {
      function hexStyles(data) {
        return data.get('pieceStyles', {'0': 'standard', '1': 'standard', '2': 'standard'});
      }
      function validHexStyles(data) {
        let styles = hexStyles(data);
        return styles is map && styles.keys().hasAll(['0', '1', '2']) &&
          styles.size() == 3 && validPieceStyle(styles['0']) &&
          validPieceStyle(styles['1']) && validPieceStyle(styles['2']);
      }
      function joinedStyles(key) {
        return validHexStyles(request.resource.data) &&
          hexStyles(request.resource.data).diff(hexStyles(resource.data))
            .affectedKeys().hasOnly([key]);
      }
      function validHexSeat(data, key, creating) {
        return data.kinds[key] in ['localHuman', 'remoteHuman', 'ai'] && (
          (data.kinds[key] == 'ai' && data.owners[key] == null) ||
          (data.kinds[key] == 'localHuman' && data.owners[key] == data.host) ||
          (data.kinds[key] == 'remoteHuman' &&
            (data.owners[key] == null || (!creating && data.owners[key] is string)))
        );
      }
      function hexReady(data) {
        return (data.kinds['0'] == 'ai' || data.owners['0'] != null) &&
               (data.kinds['1'] == 'ai' || data.owners['1'] != null) &&
               (data.kinds['2'] == 'ai' || data.owners['2'] != null);
      }
      function hexJoin(key) {
        return resource.data.ply == 0 &&
          resource.data.kinds[key] == 'remoteHuman' &&
          resource.data.owners[key] == null &&
          request.resource.data.owners[key] == request.auth.uid &&
          request.auth.uid != resource.data.host &&
          request.auth.uid != resource.data.owners['0'] &&
          request.auth.uid != resource.data.owners['1'] &&
          request.auth.uid != resource.data.owners['2'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owners', 'pieceStyles']) &&
          joinedStyles(key) &&
          request.resource.data.owners.diff(resource.data.owners).affectedKeys().hasOnly([key]);
      }
      function hexDrop(drops, index, carry) {
        return drops.size() <= index ||
          (drops[index] is int && drops[index] > 0 && drops[index] <= carry);
      }
      function hexMoveShape(move, radius, seat) {
        let carry = 2 * radius + 1;
        return move.keys().hasOnly(['seat', 'q', 'r', 'type', 'direction', 'drops']) &&
          move.seat == seat && move.q is int && move.r is int &&
          move.q >= -radius && move.q <= radius &&
          move.r >= -radius && move.r <= radius &&
          move.q + move.r >= -radius && move.q + move.r <= radius &&
          move.drops is list && (
            (move.type is int && move.type >= 0 && move.type <= 2 &&
              move.direction == -1 && move.drops.size() == 0) ||
            (move.type == -1 && move.direction is int &&
              move.direction >= 0 && move.direction <= 5 &&
              move.drops.size() > 0 && move.drops.size() <= carry &&
              hexDrop(move.drops, 0, carry) && hexDrop(move.drops, 1, carry) &&
              hexDrop(move.drops, 2, carry) && hexDrop(move.drops, 3, carry) &&
              hexDrop(move.drops, 4, carry) && hexDrop(move.drops, 5, carry) &&
              hexDrop(move.drops, 6, carry) && hexDrop(move.drops, 7, carry) &&
              hexDrop(move.drops, 8, carry))
          );
      }
      function hexAppend() {
        let seat = (resource.data.starter + resource.data.ply) % 3;
        let key = string(seat);
        let logKey = string(resource.data.ply);
        return hexReady(resource.data) &&
          (resource.data.owners[key] == request.auth.uid ||
            (resource.data.kinds[key] == 'ai' && resource.data.host == request.auth.uid)) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ply', 'moves']) &&
          request.resource.data.ply == resource.data.ply + 1 &&
          request.resource.data.moves is map &&
          request.resource.data.moves.size() == resource.data.moves.size() + 1 &&
          request.resource.data.moves.diff(resource.data.moves).affectedKeys().hasOnly([logKey]) &&
          hexMoveShape(request.resource.data.moves[logKey], resource.data.radius, seat);
      }
      // Room codes are invitations. No public room enumeration is permitted.
      allow get: if isAuthenticated();
      allow list, delete: if false;
      allow create: if isAuthenticated() && code.matches('^H[A-Z]{6}$') &&
        request.resource.data.keys().hasOnly([
          'version', 'code', 'host', 'radius', 'starter', 'ply', 'kinds', 'owners', 'moves', 'pieceStyles', 'boardTheme'
        ]) && request.resource.data.version in [1, 2] &&
        request.resource.data.code == code && request.resource.data.host == request.auth.uid &&
        request.resource.data.radius is int && request.resource.data.radius >= 2 &&
        request.resource.data.radius <= 4 && request.resource.data.starter is int &&
        request.resource.data.starter >= 0 && request.resource.data.starter <= 2 &&
        request.resource.data.ply == 0 && request.resource.data.moves is map &&
        request.resource.data.moves.size() == 0 &&
        request.resource.data.kinds is map && request.resource.data.owners is map &&
        request.resource.data.kinds.keys().hasAll(['0', '1', '2']) &&
        request.resource.data.kinds.size() == 3 &&
        request.resource.data.owners.keys().hasAll(['0', '1', '2']) &&
        request.resource.data.owners.size() == 3 &&
        validBoardTheme(request.resource.data.get('boardTheme', 'classicWood')) &&
        validHexStyles(request.resource.data) &&
        (request.resource.data.kinds['0'] != 'remoteHuman' || hexStyles(request.resource.data)['0'] == 'standard') &&
        (request.resource.data.kinds['1'] != 'remoteHuman' || hexStyles(request.resource.data)['1'] == 'standard') &&
        (request.resource.data.kinds['2'] != 'remoteHuman' || hexStyles(request.resource.data)['2'] == 'standard') &&
        validHexSeat(request.resource.data, '0', true) &&
        validHexSeat(request.resource.data, '1', true) &&
        validHexSeat(request.resource.data, '2', true);
      allow update: if isAuthenticated() &&
        (hexJoin('0') || hexJoin('1') || hexJoin('2') || hexAppend());
    }

    // Unified Square/Hex rooms. Legacy /games and /hexGames keep their formats.
    match /matches/{code} {
      function validId(id) {
        return id in ['ivory', 'charcoal', 'copper', 'jade'];
      }
      function validSeat(data, index, creating) {
        let seat = data.config.seats[index];
        let owner = data.owners[seat.id];
        return seat.keys().hasAll(['id', 'control', 'level']) &&
          seat.keys().hasOnly(['id', 'control', 'level']) && validId(seat.id) &&
          seat.control in ['localHuman', 'onlineHuman', 'ai'] &&
          seat.level in ['easy', 'medium', 'hard', 'expert'] &&
          validPieceStyle(data.styles[seat.id]) &&
          ((seat.control == 'localHuman' && owner == data.host) ||
           (seat.control == 'ai' && owner == null) ||
           (seat.control == 'onlineHuman' &&
             (owner == null || (!creating && owner is string && owner.size() > 0 && owner != data.host)) &&
             (!creating || data.styles[seat.id] == 'standard')));
      }
      function configShape(c) {
        return c.keys().hasAll(['version', 'shape', 'size', 'seats', 'starter', 'profile']) &&
          c.keys().hasOnly(['version', 'shape', 'size', 'seats', 'starter', 'profile']) &&
          c.version == 1 && c.size is int &&
          ((c.shape == 'square' && c.size >= 3 && c.size <= 8) ||
           (c.shape == 'hex' && c.size >= 2 && c.size <= 4)) &&
          c.seats is list && c.seats.size() >= 2 && c.seats.size() <= 4 &&
          (c.profile == 'sharedRoads' ||
           (c.profile == 'standardTak' && c.shape == 'square' && c.seats.size() == 2));
      }
      function validSeats(data, creating) {
        let seats = data.config.seats;
        let n = seats.size();
        return data.owners is map && data.styles is map &&
          data.owners.size() == n && data.styles.size() == n &&
          validSeat(data, 0, creating) && validSeat(data, 1, creating) &&
          (n < 3 || validSeat(data, 2, creating)) &&
          (n < 4 || validSeat(data, 3, creating)) &&
          seats[0].id != seats[1].id &&
          (n < 3 || (seats[0].id != seats[2].id && seats[1].id != seats[2].id)) &&
          (n < 4 || (seats[0].id != seats[3].id && seats[1].id != seats[3].id && seats[2].id != seats[3].id)) &&
          (data.config.starter == seats[0].id || data.config.starter == seats[1].id ||
           (n > 2 && data.config.starter == seats[2].id) || (n > 3 && data.config.starter == seats[3].id)) &&
          (seats[0].control == 'onlineHuman' || seats[1].control == 'onlineHuman' ||
           (n > 2 && seats[2].control == 'onlineHuman') || (n > 3 && seats[3].control == 'onlineHuman'));
      }
      function readySeat(data, index) {
        let seat = data.config.seats[index];
        return seat.control == 'ai' || data.owners[seat.id] != null;
      }
      function ready(data) {
        return readySeat(data, 0) && readySeat(data, 1) &&
          (data.config.seats.size() < 3 || readySeat(data, 2)) &&
          (data.config.seats.size() < 4 || readySeat(data, 3));
      }
      function starterIndex(c) {
        return c.starter == c.seats[0].id ? 0 : c.starter == c.seats[1].id ? 1 :
          c.starter == c.seats[2].id ? 2 : 3;
      }
      function currentSeat(data) {
        return data.config.seats[(starterIndex(data.config) + data.moves.size()) % data.config.seats.size()];
      }
      function vacantJoin(index) {
        let before = resource.data;
        let after = request.resource.data;
        let seat = before.config.seats[index];
        return before.resigned == null && before.moves.size() == 0 &&
          seat.control == 'onlineHuman' && before.owners[seat.id] == null &&
          after.owners[seat.id] == request.auth.uid && before.host != request.auth.uid &&
          !(request.auth.uid in before.owners.values()) &&
          after.diff(before).affectedKeys().hasOnly(['owners', 'styles']) &&
          after.owners.diff(before.owners).affectedKeys().hasOnly([seat.id]) &&
          after.styles.diff(before.styles).affectedKeys().hasOnly([seat.id]) &&
          validSeats(after, false);
      }
      function dropAt(drops, index) {
        return drops.size() > index ? drops[index] : 0;
      }
      function positiveDrop(drops, index, carry) {
        return drops.size() <= index || (drops[index] is int && drops[index] > 0 && drops[index] <= carry);
      }
      function moveShape(move, data) {
        let c = data.config;
        let carry = c.shape == 'square' ? c.size : 2 * c.size + 1;
        let drops = move.drops;
        return move.keys().hasAll(['seat', 'x', 'y', 'type', 'direction', 'drops']) &&
          move.keys().hasOnly(['seat', 'x', 'y', 'type', 'direction', 'drops']) &&
          move.seat == currentSeat(data).id && move.x is int && move.y is int &&
          ((c.shape == 'square' && move.x >= 0 && move.x < c.size && move.y >= 0 && move.y < c.size) ||
           (c.shape == 'hex' && move.x >= -c.size && move.x <= c.size && move.y >= -c.size && move.y <= c.size &&
             move.x + move.y >= -c.size && move.x + move.y <= c.size)) && drops is list &&
          ((move.type in ['flat', 'standing', 'capstone'] && move.direction == null && drops.size() == 0 &&
             (data.moves.size() >= c.seats.size() || move.type == 'flat')) ||
           (move.type == null && data.moves.size() >= c.seats.size() &&
            move.direction in ['east', 'northWest', 'west', 'southEast', 'northEast', 'southWest'] &&
            (c.shape == 'hex' || move.direction in ['east', 'northWest', 'west', 'southEast']) &&
            drops.size() > 0 && drops.size() <= carry &&
            positiveDrop(drops, 0, carry) && positiveDrop(drops, 1, carry) && positiveDrop(drops, 2, carry) &&
            positiveDrop(drops, 3, carry) && positiveDrop(drops, 4, carry) && positiveDrop(drops, 5, carry) &&
            positiveDrop(drops, 6, carry) && positiveDrop(drops, 7, carry) && positiveDrop(drops, 8, carry) &&
            dropAt(drops, 0) + dropAt(drops, 1) + dropAt(drops, 2) + dropAt(drops, 3) + dropAt(drops, 4) +
              dropAt(drops, 5) + dropAt(drops, 6) + dropAt(drops, 7) + dropAt(drops, 8) <= carry));
      }
      function appendMove() {
        let before = resource.data;
        let after = request.resource.data;
        let seat = currentSeat(before);
        let n = before.moves.size();
        return before.resigned == null && ready(before) &&
          (before.owners[seat.id] == request.auth.uid ||
           (seat.control == 'ai' && before.aiRunner == request.auth.uid &&
            before.aiLeaseAt is timestamp && request.time < before.aiLeaseAt + duration.value(30, 's'))) &&
          after.diff(before).affectedKeys().hasOnly(['moves']) &&
          after.moves is list && after.moves.size() == n + 1 &&
          after.moves == before.moves.concat([after.moves[n]]) && moveShape(after.moves[n], before);
      }
      function resignSeat() {
        let before = resource.data;
        let after = request.resource.data;
        return before.resigned == null && ready(before) && validId(after.resigned) &&
          before.owners[after.resigned] == request.auth.uid &&
          after.diff(before).affectedKeys().hasOnly(['resigned']);
      }
      function runnerLease() {
        let before = resource.data;
        let after = request.resource.data;
        return before.resigned == null && ready(before) &&
          (before.host == request.auth.uid || request.auth.uid in before.owners.values()) &&
          (before.config.seats[0].control == 'ai' || before.config.seats[1].control == 'ai' ||
           (before.config.seats.size() > 2 && before.config.seats[2].control == 'ai') ||
           (before.config.seats.size() > 3 && before.config.seats[3].control == 'ai')) &&
          (before.aiRunner == request.auth.uid || before.aiLeaseAt == null ||
           request.time >= before.aiLeaseAt + duration.value(30, 's')) &&
          after.diff(before).affectedKeys().hasOnly(['aiRunner', 'aiLeaseAt']) &&
          after.aiRunner == request.auth.uid && after.aiLeaseAt == request.time;
      }
      allow get: if isAuthenticated();
      allow list, delete: if false;
      allow create: if isAuthenticated() && code.matches('^U[A-Z]{6}$') &&
        request.resource.data.keys().hasAll(['version', 'code', 'host', 'config', 'owners', 'styles', 'boardTheme', 'moves', 'resigned', 'aiRunner', 'aiLeaseAt']) &&
        request.resource.data.keys().hasOnly(['version', 'code', 'host', 'config', 'owners', 'styles', 'boardTheme', 'moves', 'resigned', 'aiRunner', 'aiLeaseAt']) &&
        request.resource.data.version == 1 && request.resource.data.code == code &&
        request.resource.data.host == request.auth.uid && configShape(request.resource.data.config) &&
        validSeats(request.resource.data, true) && validBoardTheme(request.resource.data.boardTheme) &&
        request.resource.data.moves is list && request.resource.data.moves.size() == 0 && request.resource.data.resigned == null &&
        request.resource.data.aiRunner == null && request.resource.data.aiLeaseAt == null;
      allow update: if isAuthenticated() &&
        ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owners', 'styles']) &&
          (vacantJoin(0) || vacantJoin(1) ||
           (resource.data.config.seats.size() > 2 && vacantJoin(2)) ||
           (resource.data.config.seats.size() > 3 && vacantJoin(3)))) ||
         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['moves']) && appendMove()) ||
         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resigned']) && resignSeat()) ||
         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aiRunner', 'aiLeaseAt']) && runnerLease()));
    }

    // Preserve the existing production profile and achievement policies.
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
    match /achievements/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Deny all other database access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
